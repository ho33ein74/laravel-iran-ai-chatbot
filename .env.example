# ==========================================
# تنظیمات اصلی چت‌بات
# ==========================================
# درایور پیش‌فرض: (avalai, gapgpt, openai, gemini, local_offline)
IRAN_AI_DRIVER=gapgpt

# تنظیمات اختصاصی سرویس GapGPT (انتخاب مدل)
GAPGPT_API_KEY="your_gapgpt_api_key_here"
GAPGPT_MODEL="gpt-4o-mini"
GAPGPT_ENDPOINT="https://api.gapgpt.app/v1/chat/completions"

# کلیدهای API سایر سرویس‌دهنده‌ها
AVALAI_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# آیا کاربر حتما باید در سایت لاگین کرده باشد؟ (true/false)
IRAN_AI_AUTH_REQUIRED=false
IRAN_AI_RAG_ENABLED=true

# جستجوی خودکار در دیتابیس (محصولات/مقالات)
IRAN_AI_MODELS_SEARCH=true
IRAN_AI_SEARCH_LIMIT=4

# تنظیمات ظاهری (رنگ و نام)
IRAN_AI_UI_COLOR="#1a56db"
IRAN_AI_BOT_NAME="دستیار هوشمند"