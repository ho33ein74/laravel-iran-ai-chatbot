{
    "name": "unixscript/laravel-iran-ai-chatbot",
    "description": "A comprehensive AI Chatbot package for Laravel with GapGPT, AvalAI, OpenAI, Gemini, Local models, RAG, Auth handling and UI settings.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "chatbot", "avalai", "gapgpt", "openai", "gemini", "rag"],
    "authors": [
        {
            "name": "Hossein Beiki",
            "email": "ho33ein.b@gmail.com.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Unixscript\\IranAiChatbot\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Unixscript\\IranAiChatbot\\IranAiServiceProvider"
            ]
        }
    }
}
